# PostgreSQL connection string (Supabase or local Postgres both work)
# Example (Supabase): postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Example (local):    postgresql://cybersos:cybersos@localhost:5432/cybersos
DATABASE_URL=postgresql://cybersos:cybersos@localhost:5432/cybersos

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SERVICE_NAME=cybersos-api
API_V1_PREFIX=/api/v1

# Retain the previous evidence directory when upgrading an existing database.
# LOCAL_STORAGE_ROOT overrides EVIDENCE_STORAGE_DIR when set.
EVIDENCE_STORAGE_DIR=./evidence
LOCAL_STORAGE_ROOT=
MAX_EVIDENCE_FILE_SIZE_MB=10

# Optional private storage. Both credentials are needed; otherwise use local disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=cybersos-evidence

# Existing deterministic providers work without credentials or optional SDKs.
EXTRACTION_PROVIDER=heuristic
SUMMARY_PROVIDER=template
ANTHROPIC_API_KEY=
# No model is assumed. Set this only for explicitly configured provider use.
ANTHROPIC_MODEL=

# Secure defaults for private case capabilities. Local HTTP synthetic testing only:
# set CASE_COOKIE_SECURE=false; deploy behind HTTPS with this true.
CASE_COOKIE_SECURE=true
CASE_ACCESS_TTL_SECONDS=604800
