# PostgreSQL connection string (Supabase or local Postgres both work)
# Example (Supabase): postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Example (local):    postgresql://cybersos:cybersos@localhost:5432/cybersos
DATABASE_URL=postgresql://cybersos:cybersos@localhost:5432/cybersos

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000
