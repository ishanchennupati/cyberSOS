# PostgreSQL connection string (Supabase or local Postgres both work)
# Example (Supabase): postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Example (local):    postgresql://cybersos:cybersos@localhost:5432/cybersos
DATABASE_URL=postgresql://cybersos:cybersos@localhost:5432/cybersos

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Phase 3: Evidence Vault -------------------------------------------

# Supabase project. Leave both blank to use local-disk storage under
# ./var/evidence-storage instead (fine for local dev/demo/tests).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=cybersos-evidence

# File-size limits, in megabytes.
MAX_EVIDENCE_FILE_SIZE_MB=10
MAX_ID_DOCUMENT_SIZE_MB=5

# Evidence extraction provider: "heuristic" (default, no API key needed,
# reads PDF/TXT) or "anthropic" (reads screenshots too, needs an API key).
EXTRACTION_PROVIDER=heuristic

# Incident-summary provider: "template" (default, no API key needed) or
# "anthropic".
SUMMARY_PROVIDER=template

# Only needed if EXTRACTION_PROVIDER or SUMMARY_PROVIDER is "anthropic".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Shows the "demo environment — synthetic data only" banner in the UI.
DEMO_MODE=true
